# /etc/systemd/system/chatra-uptime.service
# Запускать на машине ВНЕ основного сервера Chatra (или хотя бы вне
# uvicorn-процесса): монитор должен пережить падение приложения.
# Env-переменные читаются из /etc/default/chatra-uptime
[Unit]
Description=Chatra uptime monitor (Telegram alerts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/chatra-uptime
ExecStart=/usr/bin/env python3 /opt/chatra/scripts/uptime_monitor.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (production):
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/chatra

# SQLite (local development):
# DATABASE_URL=sqlite:///./chatra.db

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED: the app refuses to start without real secrets (no defaults).
# Generate each with: openssl rand -hex 32
SECRET_KEY=
REFRESH_SECRET_KEY=

# ── OpenAI API ────────────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Paste it here WITHOUT quotes:
OPENAI_API_KEY=sk-...your-key-here...

# ── Upload settings ───────────────────────────────────────────────────────────
# Base URL used to build file download links returned by /upload/
# In production set to your domain, e.g.: https://api.yourdomain.com
APP_BASE_URL=http://localhost:8000

# ── RAG (Retrieval-Augmented Generation) ─────────────────────────────────────
# Embedding model (text-embedding-3-small is cheapest, 1536-dim)
EMBED_MODEL=text-embedding-3-small
# LLM for answering queries
CHAT_MODEL=gpt-4o-mini
# Tokens per chunk (300–800 recommended)
CHUNK_SIZE=512
# Overlap between consecutive chunks
CHUNK_OVERLAP=64
# How many chunks to retrieve per query
TOP_K=5
# Hard token cap sent to LLM (never exceeded)
MAX_CONTEXT_TOKENS=3000

# ── Cloudflare R2 (объектное хранилище для НОВЫХ файлов) ─────────────────────
# Файлы, загруженные до подключения R2, остаются в локальной папке uploads/ и
# продолжают отдаваться как раньше — эти переменные их не касаются. Все
# новые загрузки (POST /upload/, обложки классов, TTS/видео аватара, слайды
# лекций) идут в R2 через services/storage/ (S3-совместимый API).
#
# Создайте бакет и API-токен (S3 Access Key/Secret) в Cloudflare Dashboard →
# R2 → Manage R2 API Tokens.
# REQUIRED в проде (без них POST /upload/ и генерация аватар-контента упадут):
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# На dev и prod используйте РАЗНЫЕ бакеты (например chatra-dev / chatra-prod),
# чтобы тестовые загрузки не попадали в продакшн-хранилище.
R2_BUCKET_NAME=chatra-dev
# Опционально: свой endpoint вместо стандартного
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=
# Опционально: домен собственного CDN перед бакетом (например
# cdn.chatra.aican.cloud) или публичный r2.dev-домен бакета — включается
# вручную в Cloudflare (R2 → бакет → Settings → Public access), это не
# часть S3 API, из кода не переключается. Затрагивает ТОЛЬКО не-приватные
# категории (сейчас — обложки классов, materials/covers/...; см. раздел
# "Оптимизация обложек классов" в README): без этой переменной они
# по-прежнему идут через защищённый прокси /uploads/… (тоже быстрее, чем
# раньше, но не так быстро, как отдача напрямую из R2/CDN); с ней — отдаются
# прямой публичной ссылкой в обход бэкенда целиком. Приватные категории
# (сдачи, эталоны и т.п.) всегда остаются за HMAC-подписью независимо от
# этой переменной.
# R2_PUBLIC_BASE_URL=https://cdn.chatra.aican.cloud

# ── Email (SMTP: Brevo или совместимый провайдер) ────────────────────────────
# Нужен для кодов подтверждения email и восстановления пароля.
# Brevo: SMTP-ключ создаётся в Brevo → SMTP & API → SMTP.
# Если оставить SMTP_HOST пустым — письма не шлются, код пишется в лог сервера
# (dev-режим), а при OTP_DEBUG=1 код возвращается в ответе API (НЕ включать в проде!).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Chatra
# OTP_DEBUG=1  # только для локальной разработки: возвращает код в ответе API

# ── AI avatars (ElevenLabs TTS + D-ID talking head) ──────────────────────────
# Опционально. Без ключей аватар говорит стандартным голосом / без видео.
# ELEVENLABS_API_KEY=
# DID_API_KEY=

# ── Push-уведомления (Firebase Cloud Messaging, HTTP v1) ─────────────────────
# Опционально. Укажите ЛИБО путь к JSON сервис-аккаунта, ЛИБО его содержимое.
# Без них push-уведомления просто не отправляются.
# FCM_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# FCM_SERVICE_ACCOUNT_JSON=

# ── AI-лимиты ────────────────────────────────────────────────────────────────
# Дневной лимит сообщений ИИ на пользователя (0 = без лимита; по умолчанию 50).
# AI_DAILY_MESSAGE_LIMIT=50
# Дневной бюджет токенов ИИ на организацию (0/отрицательное = выключен; по умолч. 2000000).
# AI_DAILY_TOKEN_BUDGET=2000000

# ── Прочее (опционально, есть значения по умолчанию) ─────────────────────────
# CORS: список origin'ов через запятую. По умолчанию '*' (credentials выключены).
# В проде задайте явный список, иначе браузерные сессии с cookie не работают.
# CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
# Каталог для загруженных файлов (по умолчанию ./uploads).
# UPLOAD_DIR=uploads
# Срок жизни подписи ссылок на /uploads в секундах (по умолчанию 86400 = сутки).
# FILE_URL_TTL=86400
# Общий rate-limiter между воркерами. Без него лимитер работает in-memory (per-process).
# REDIS_URL=redis://localhost:6379/0
